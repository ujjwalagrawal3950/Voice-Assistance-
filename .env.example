# Virtual KAM — Environment configuration (placeholders only)
# Copy to .env and fill in values. Never commit real secrets.

# Application
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-secure-random-key-in-production
SELLER_ID=demo-seller-001

# Database
DATABASE_URL=sqlite:///./virtual_kam.db

# # Ollama (local LLM — temporarily commented out while using Google Gemini API)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Online LLM API (Google Gemini — free tier via Google AI Studio, server-side only)
GOOGLE_API_KEY=your-google-ai-studio-api-key
GOOGLE_MODEL=gemini-3-flash-preview
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Voice (STT/TTS providers — local by default)
STT_PROVIDER=faster_whisper
STT_MODEL=base
TTS_PROVIDER=piper
TTS_MODEL_PATH=./models/piper/en_US-lessac-medium.onnx
VOICE_TRANSPORT=webrtc

# Pipecat
PIPECAT_HOST=0.0.0.0
PIPECAT_PORT=8765
